\newcommand{\carga}[2][c]{
    \IfEqCase {#1}{
        {c}{\SI{#2}{\coulomb}\;}
        {mc}{\SI{#2}{\milli\coulomb}\;}
        {microc}{\SI{#2}{\micro\coulomb}\;}
        {nc}{\SI{#2}{\nano\coulomb}\;}
        {pc}{\SI{#2}{\pico\coulomb}\;}
    }
}

\newcommand{\velocidad}[2][ms]{
    \IfEqCase {#1}{
        {ms}{\SI{#2}{\metre\per\s}\;}
        {kmh}{\SI{#2}{\kilo\metre\per\s}\;}
        {kms}{\SI{#2}{\kilo\metre\per\s}\;}
    }
}

\newcommand{\distancia}[2][m]{
    \IfEqCase {#1}{
        {m}{\SI{#2}{\m}\;}
        {km}{\SI{#2}{\kilo\m}\;}
        {cm}{\SI{#2}{\centi\m}\;}
        {mm}{\SI{#2}{\milli\m}\;}
        {dm}{\SI{#2}{\deci\m}\;}
        {nm}{\SI{#2}{\nano\m}\;}
        {microm}{\SI{#2}{\micro\m}\;}
    }
}

\newcommand{\masa}[2][g]{
    \IfEqCase{#1}{
        {g}{\SI{#2}{\g}\;}
        {mg}{\SI{#2}{\milli\g}\;}
        {kg}{\SI{#2}{\kilo\g}\;}
