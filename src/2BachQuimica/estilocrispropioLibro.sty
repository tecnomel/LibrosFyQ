\RequirePackage{answers}

%-------------------------------------------------
% SISTEMA UNIFICADO DE SOLUCIONES
% exercise / question / exerciseEVAU capturan su cuerpo, lo separan en
% enunciado + \begin{solu}...\end{solu} y escriben en soluciones.tex:
%   unidad (\section), tipo (\subsection*), enunciado y solución.
% Los tres tipos se distinguen por el entorno contenedor, así que dentro
% siempre se usa \begin{solu}. Rótulos: Ejercicio / Cuestión / Ejercicio PAU.
% (Los nombres internos exerciseEVAU/soluEVAU se conservan: solo cambia lo visible.)
%-------------------------------------------------
\makeatletter

\gdef\crisChapTitle{}
\gdef\crisLastChap{-1}
\gdef\crisLastTipo{}

% Guarda el título del capítulo para poder escribirlo en la cabecera de unidad
\let\crisOldChaptermark\chaptermark
\renewcommand{\chaptermark}[1]{\gdef\crisChapTitle{#1}\crisOldChaptermark{#1}}

% Rótulos según el tipo (ex = ejercicio, q = cuestión, pau = ejercicio PAU)
\@namedef{crisTH@ex}{Ejercicios}
\@namedef{crisTH@q}{Cuestiones}
\@namedef{crisTH@pau}{Ejercicios PAU}
\@namedef{crisTL@ex}{Ejercicio}
\@namedef{crisTL@q}{Cuestión}
\@namedef{crisTL@pau}{Ejercicio PAU}

% Macros que se ejecutan al leer soluciones.tex
\newcommand{\crisUnitHeader}[2]{%
    \section*{\chaptername~#1.~#2}%
    \addcontentsline{toc}{section}{\chaptername~#1.~#2}%
}
\newcommand{\crisTypeHeader}[1]{\subsection*{\csname crisTH@#1\endcsname}}
\newcommand{\crisSolEntry}[4]{%
    \begin{solBox}%
        \noindent{\small\sffamily\bfseries\color{ocre}\csname crisTL@#1\endcsname~#2}%
        \par\vspace{3pt}%
        \noindent\textbf{Enunciado.}~#3\par\medskip
        \noindent\textbf{Solución.}~#4%
    \end{solBox}%
}

% Escritura directa (un solo \write): \Writetofile expande dos veces y ejecutaría los \section
\newcommand{\crisOut}[1]{\@bsphack\ifansopen\immediate\write\ans@file{#1}\fi\@esphack}

% Escribe cabeceras (si cambian unidad o tipo) y la entrada completa
\newcommand{\crisWrite}[3]{% #1 tipo, #2 enunciado, #3 solución
    \ifnum\crisLastChap=\value{chapter}\else
        \crisOut{\noexpand\crisUnitHeader{\thechapter}{\unexpanded\expandafter{\crisChapTitle}}}%
        \xdef\crisLastChap{\number\value{chapter}}%
        \gdef\crisLastTipo{}%
    \fi
    \def\crisTmp{#1}%
    \ifx\crisTmp\crisLastTipo\else
        \crisOut{\noexpand\crisTypeHeader{#1}}%
        \global\let\crisLastTipo\crisTmp
    \fi
    \crisOut{\noexpand\crisSolEntry{#1}{\@currentlabel}{\unexpanded{#2}}{\unexpanded{#3}}}%
}

% Separa el cuerpo en enunciado y solución (la solución es opcional).
% No se puede usar \begin{solu} como delimitador (la llave cerraría la
% definición), así que se escanean los \begin/\end y se compara el nombre.
\def\crisSoluNm{solu}
\long\def\crisScanB#1#2#3\begin#4#5\crisQ{% tipo, enunciado acumulado, previo, nombre, resto
    \def\crisNm{#4}%
    \ifx\crisNm\crisSoluNm
        \crisScanE{#1}{#2#3}{}#5\crisQ
    \else
        \crisScanB{#1}{#2#3\begin{#4}}#5\crisQ
    \fi
}
\long\def\crisScanE#1#2#3#4\end#5#6\crisQ{% tipo, enunciado, solución acumulada, previo, nombre, resto
    \def\crisNm{#5}%
    \ifx\crisNm\crisSoluNm
        \crisFinish{#1}{#2}{#3#4}%
    \else
        \crisScanE{#1}{#2}{#3#4\end{#5}}#6\crisQ
    \fi
}
\long\def\crisFinish#1#2#3{%
    #2%
    \def\crisSolTxt{#3}%
    \ifx\crisSolTxt\@empty\else\crisWrite{#1}{#2}{#3}\fi
}

\newcommand{\crisEnvRun}[4]{% #1 tipo, #2 caja, #3 teorema, #4 cuerpo
    \begin{#2}\begin{#3}%
        \crisScanB{#1}{}#4\begin{solu}\end{solu}\crisQ
        \hfill{\color{ocre}\tiny\ensuremath{\blacksquare}}%
    \end{#3}\end{#2}%
}

\NewDocumentEnvironment{solu}{+b}{}{}  % solo se usa dentro de exercise/question/exerciseEVAU
\RenewDocumentEnvironment{exercise}{+b}{\crisEnvRun{ex}{eBox}{exerciseT}{#1}}{}
\RenewDocumentEnvironment{question}{+b}{\crisEnvRun{q}{qBox}{questionT}{#1}}{}
\RenewDocumentEnvironment{exerciseEVAU}{+b}{\crisEnvRun{pau}{eBox}{exerciseEVAUT}{#1}}{}

\makeatother



% 1. Ajustamos tu \mybox para que acepte el nombre y el número
% He quitado el contador manual para que use el del teorema (es más seguro)

% Ahora \mybox solo pone en negrita y enmarca lo que reciba
\newcommand{\myboxcm}[1]{%
  \noindent\xmybox{\phantom{l}\textbf{#1}\phantom{j}}%
}


% 2. Creamos el estilo del teorema
\newtheoremstyle{ejerciciobox}
  {10pt}                % Espacio superior
  {10pt}                % Espacio inferior
  {\normalfont}         % Fuente del cuerpo
  {}                    % Sangría
  {\bfseries}           % Fuente del encabezado
  {}                    % Puntuación después del encabezado
  {0.5em}               % Espacio después del encabezado
  {\myboxcm{#1 #2}}       % <--- AQUÍ: #1 es "Ejercicio" y #2 es el número

% 3. Asignamos el estilo y creamos el teorema
\theoremstyle{ejerciciobox}
\newtheorem{exerciseCMM}{}


