        right=8mm,
        boxrule=0.8pt,
        colback=red!5!white,
        colframe=red!75!black,fonttitle=\bfseries,
fonttitle=\bfseries,
center title,
title={},
lifted shadow={1mm}{-2mm}{3mm}{0.1mm}{black!50!white},
leftrule=1.5mm,
width=0.8\textwidth
#1    
}