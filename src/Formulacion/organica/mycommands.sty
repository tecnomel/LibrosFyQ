\newcommand{\masa}[2][g]{
    \IfEqCase {#1}{
        {g}{\SI{#2}{\g}}
        {mg}{\SI{#2}{\milli\g}}
        {kg}{\SI{#2}{\milli\g}}
    }
}
\newcommand{\densidad}[2][gl]{
    \IfEqCase {#1}{
        {gl}{\SI{#2}{\g\per\liter}}
        {gml}{\SI{#2}{\g\per\milli\liter}}
    }
}

\newcommand{\volumen}[2][l]{
    \IfEqCase {#1}{
        {l}{\SI{#2}{\liter}}
        {ml}{\SI{#2}{\milli\liter}}
        {metroscubicos}{\SI{#2}{\cubic\m}}
        {decimetroscubicos}{\SI{#2}{\cubic\deci\m}}
        {centiimetroscubicos}{\SI{#2}{\cubic\centi\m}}
    }
}


